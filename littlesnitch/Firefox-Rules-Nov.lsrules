{
  "name": "Firefox-Rules-Nov",
  "description": "Standard app traffic from Firefox",
  "rules": [
  {
    "notes":"0.Default deny quic",
  "action" : "deny",
    "ports" : "443",
    "priority" : "high",
 "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
    "protocol" : "udp",
    "remote" : "any"
  },
  {
    "notes":"0.Allow nat-stunUDP",
  "action" : "allow",
    "ports" : "3478",
    "priority" : "high",
 "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
    "protocol" : "udp",
    "remote" : "any"
  },
  {
 "notes":"0.Default deny WWW/443",
    "action" : "deny",
    "ports" : "443",
"process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
    "protocol" : "tcp",
    "remote-domains" : 
  ["facebook.com",
  "facebook.net",
  "tiktokcdn.com",
"g.doubleclick.net",
      "static.doubleclick.net"
  ]
  },
    {
    "notes":"Google/ Youtube Domains 443",
     "action" : "allow",
     "ports" : "443",
      "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
          "protocol" : "tcp",
          "remote-domains" : [
		  "googlevideo.com",
		  "dl.google.com",
		  "accounts.google.com",
		  "googleapps.com",
		  "googleusercontent.com",
		  "googletagmanager.com",
		  "gogleanalytics.com",
		  "google-analytics.com",
		  "googlesyndication.com",
		  "googletagservices.com",
		  "googleapis.com",
		  "withgoogle.com",
		  "fonts.gstatic.com",
		  "www.gstatic.com",
		  "gstatic.com",
			"c.youtube.com",
			"accounts.youtube.com",
			"youtube.com",
			"youtube.be"
        ]
		},
      {
  	"notes":"Mozilla.com Domains 443",
        "action" : "allow",
        "ports" : "443",
   		 "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
        "protocol" : "tcp",
        "remote-domains" : [
        "mozilla.com",
  		"mozilla.net", 
  		"mozgcp.net",        
  	  	"classify-services.mozilla.com",
        "firefox.settings.services.mozilla.com",  
  		"mozilla-ohttp.fastly-edge.com",
  		"ohttp-merino.mozilla.fastly-edge.com",
  		"mozilla.fastly-edge.com"
      ]
  },
      {
  	"notes":"Mozilla.org Domains 443",
        "action" : "allow",
        "ports" : "443",
   		 "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
        "protocol" : "tcp",
        "remote-domains" : [   
  		"addons.mozilla.org",
        "aus5.mozilla.org",
        "download.mozilla.org",
        "telemetry.mozilla.org",
        "vpn.mozilla.org",
		"ads-img.mozilla.org"
  	      ]
      },
      {
  	"notes":"Firefox Domains 443",
        "action" : "allow",
        "ports" : "443",
   		 "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
        "protocol" : "tcp",
        "remote-domains" : [
          "accounts.firefox.com",
          "firefox-portal-detection.com",
          "firefox.com",
			"firefox.org"
        ]
      },
      {
  	"notes":"Mozilla port 80",
        "action" : "allow",
        "ports" : "80",
   		 "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
        "protocol" : "tcp",
        "remote-domains" : [
		"mozilla.com",
		"firefox-portal-detection.com",
		"ads-img.mozilla.org",
		"ads.mozilla.org"
      ]
	},
      {
    "notes":"Github Domains 443",
         "action" : "allow",
         "ports" : "443",
 "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
         "protocol" : "tcp",
         "remote-domains" : [
           "avatars.githubusercontent.com",
    	"githubassets.com",
           "cafe.github.com",
           "central.github.com",
           "githubusercontent.com",
           "github.com",
           "github.io"
         ]
       },
         {
       "notes":"Gitlab Domains 443",
            "action" : "allow",
            "ports" : "443",
"process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
            "protocol" : "tcp",
            "remote-domains" : [
  	"malware-filter.gitlab.io",	  
              "gitlab.com",
              "gitlab.io"
            ]
          },
    {
      "notes": "Atlassian",
      "action": "allow",
      "ports": "443",
"process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
	  "protocol" : "tcp",
      "remote-domains": ["atl-paas.net","atlassian.com","atlassian.net",      	"atlassian.io","bitbucket.org","bytebucket.org","jira.com","valiantys.com"]
    },

    {
      "notes": "Terraform",
      "action": "allow",
      "ports": "443",
"process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
	      "protocol" : "tcp",
      "remote-domains": ["terraform.net","terraform.com"]
    },
    {
  	"notes":"Firewall WWW ",
      "action" : "allow",
      "ports" : "443",
"process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
      "protocol" : "tcp",
      "remote-domains" : [
        "paloaltonetworks.co.uk",
        "paloaltonetworks.com",
  	"fortinet.com",
  	"firewall.com",
	"firewall.net",
	"zscaler.com",
	"cisco.com"	
      ]
    },
    {
  	"notes":"Domains Personal 2083",
      "action" : "allow",
      "ports" : "2083",
"process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
      "protocol" : "tcp",
      "remote-domains" : [
        "audaxum.me",
        "bluehost.com",
        "goethals.us",
        "nixihost.com"
      ]
    },
  {	
  	"notes":"Domains Personal 2096",
      "action" : "allow",
