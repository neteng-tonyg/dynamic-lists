{
  "name": "Rulesset-Any-Process",
  "description": "Standard app traffic for all browsers",
  "rules": [
  {
    "notes":"0.Default deny quic",
  "action" : "deny",
    "ports" : "443",
    "priority" : "high",
      "process": "any",
    "protocol" : "udp",
    "remote" : "any"
  },
        {
      "action": "allow",
      "process": "any",
      "ports": "443",
      "protocol": "tcp",
      "remote-domains": [
        "lucid.app",
        "excalidraw.com",
        "lucidcdn.net",
        "lucidchart.net"
      ]
    },
    {
  "description": "Microsoft-related domains",
  "name": "Microsoft",
  "rules": [
    {
      "action": "deny",
      "owner": "me",
      "process": "any",
      "remote-domains": "pipe.aria.microsoft.com"
    },
    {
      "action": "allow",
      "owner": "me",
      "process": "any",
      "remote-domains": [
        "azurewebsites.net",
        "bing.com",
        "hockeyapp.net",
        "live.com",
        "live.net",
        "microsoft.com",
        "microsoftonline.com",
        "msedge.net",
        "oaspapps.com",
        "office.com",
        "office.net",
        "office365.com",
        "onedrive.com",
        "outlook.com",
        "skype.com",
        "windows.com"
      ]
    }
  ]
}
  ]
}