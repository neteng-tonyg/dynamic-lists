{
  "name": "Rulesset-Any-Process",
  "description": "Standard app traffic for all browsers",
  "rules": [
  {
    "notes":"0.Default deny quic",
  "action" : "deny",
      "owner": "me",
    "ports" : "443",
    "priority" : "high",
      "process": "any",
    "protocol" : "udp",
    "remote" : "any"
  },
        {
      "action": "allow",
            "owner": "me",
      "process": "any",
      "ports": "443",
      "protocol": "tcp",
      "remote-domains": [
        "lucid.app",
        "excalidraw.com",
        "lucidcdn.net",
        "lucidchart.net"
      ]
    },
     {
    "notes":"0.Allow nat-stunUDP",
  "action" : "allow",
    "ports" : "3478",
    "priority" : "high",
 "process" : "any",
       "owner" : "me",
    "protocol" : "udp",
    "remote" : "any"
  },
  {
 "notes":"0.Default deny WWW/443",
    "action" : "deny",
    "ports" : "443",
 "process" : "any",
       "owner" : "me",
    "protocol" : "tcp",
    "remote-domains" :
  ["facebook.com",
  "facebook.net",
  "tiktokcdn.com",
"g.doubleclick.net",
      "static.doubleclick.net"
  ]
  },
    {
    "notes":"Google/ Youtube Domains 443",
     "action" : "allow",
     "ports" : "443",
 "process" : "any",
       "owner" : "me",
          "protocol" : "tcp",
          "remote-domains" : [
		  "googlevideo.com",
		  "dl.google.com",
		  "www.google.com",
		  "accounts.google.com",
		  "play.google.com",
		  "googleapps.com",
		  "googleusercontent.com",
		  "googletagmanager.com",
		  "gogleanalytics.com",
		  "google-analytics.com",
		  "googlesyndication.com",
		  "googletagservices.com",
		  "googleapis.com",
		  "withgoogle.com",
		  "fonts.gstatic.com",
		  "www.gstatic.com",
		  "gstatic.com",
			"c.youtube.com",
			"accounts.youtube.com",
			"youtube.com",
			"youtube.be"
        ]
		},
      {
  	"notes":"Mozilla.com Domains 443",
       "process" : "any",
       "owner" : "me",
        "action" : "allow",
        "ports" : "443",
   		 "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
        "protocol" : "tcp",
        "remote-domains" : [
        "mozilla.com",
  		"mozilla.net",
  		"mozgcp.net",
  	  	"classify-services.mozilla.com",
        "firefox.settings.services.mozilla.com",
  		"mozilla-ohttp.fastly-edge.com",
  		"ohttp-merino.mozilla.fastly-edge.com",
  		"mozilla.fastly-edge.com"
      ]
  },
    {
  "description": "Microsoft-related domains",
  "name": "Microsoft",
  "rules": [
    {
      "action": "allow",
      "process" : "any",
       "owner" : "me",
      "remote-domains": [
        "azurewebsites.net",
        "bing.com",
        "hockeyapp.net",
        "live.com",
        "live.net",
        "microsoft.com",
        "microsoftonline.com",
        "msedge.net",
        "oaspapps.com",
        "office.com",
        "office.net",
        "office365.com",
        "onedrive.com",
        "outlook.com",
        "skype.com",
        "windows.com"
      ]
    }
  ]
}
  ]
}