        "adtrafficquality.google.com"
	  ]
    },
        {
      "notes" :  "211-Allow nat-stun-UDP-3478",
        "action" : "allow",
        "ports" : "3478",
        "process" : "\/Applications\/LibreWolf.app\/Contents\/MacOS\/librewolf",
        "protocol" : "udp",
        "remote" : "any"
    },
       {
