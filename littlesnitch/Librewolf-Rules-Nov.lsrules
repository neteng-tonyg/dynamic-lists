{
  "name": "Librewolf-3.21-Nov",
    "description" :
    "AnyProc + MajorDomains+Reddit+Lucid+Plex+Filen",
  "rules": [
    {
    "notes ": "000-Default Deny Quic",
    "priority" : "high",
    "action": "deny",
    "ports": "443",
      "process" : "\/Applications\/LibreWolf.app\/Contents\/MacOS\/librewolf",
    "protocol": "udp",
    "remote": "any"
    },
    {
    "notes" : "003-Default deny WWW/443",
    "priority" : "high",
    "action" : "deny",
    "ports" : "443",
  "process" : "\/Applications\/LibreWolf.app\/Contents\/MacOS\/librewolf",
    "protocol" : "tcp",
    "remote-domains" : [
      "facebook.com",
      "facebook.net",
      "tiktokcdn.com",
      "g.doubleclick.net",
      "static.doubleclick.net"
    ]
  },
    {
      "notes":"111-Deny Google Analytics Subnets",
      "priority" : "high",
      "action" : "deny",
      "ports" : "any",
       "process" : "\/Applications\/LibreWolf.app\/Contents\/MacOS\/librewolf",
      "protocol" : "tcp",
      "remote-addresses" : [
	    "64.233.177.0/24",
	    "173.194.219.0/24",
	    "142.250.105.0/24",
	    "142.250.9.0/24",
	    "74.125.21.0/24"
	  ]
    },
        {
      "notes" : "117-Deny Google Analytics Hosts",
      "action" : "deny",
      "ports" : "443",
      "priority" : "high",
