{
  "name": "Safari-3.x_rules",
   "description" :
    "AnyProc + MajorDomains+Reddit+Lucid+Plex+Filen",
  "rules": [

    {
      "notes" : "Random AI domains",
      "action": "allow",
      "ports": "443",
      "process" : "\/Applications\/Safari.app\/Contents\/MacOS\/Safari",
      "protocol": "tcp",
      "remote-domains": [
        "duck.ai",
		"urboscribe.ai",
		"factors.ai",
		"engagement.ai",
		"reco.ai",
		"hybrid.ai",
        "huggingface.co"
        ]
    },
        {
      "notes" : "Random Top Domains",
      "action": "allow",
      "ports": "443",
      "process" : "\/Applications\/Safari.app\/Contents\/MacOS\/Safari",
      "protocol": "tcp",
      "remote-domains": [
        "nmap.com",
		"nmap.org",
        "wireshark.com",
		"videolan.org",
		"mail.com",
        "okta.com",
        "sentry.io",
		"reco.ai",
		"hybrid.ai"
        ]
    },
    {
        "notes": "Reddit WWW",
        "action": "allow",
        "process" :"\/Applications\/Safari.app\/Contents\/MacOS\/Safari",
        "protocol": "tcp",
        "remote-domains": [
        "redditspace.com",
        "redditstatic.com",
        "Redditmedia.com",
        "reddit.com",
        "www.reddit.com",
        "preview.redd.it",
        "redd.it"
        ]
    },
        {
      "notes" : "Lucid",
      "action": "allow",
      "ports": "443",
      "process" :"\/Applications\/Safari.app\/Contents\/MacOS\/Safari",
      "protocol": "tcp",
      "remote-domains": [
        "lucid.app",
        "excalidraw.com",
        "lucidcdn.net",
        "lucidchart.net"
        ]
    },
    {
     "notes" : "Plex, Filen, Seedbox ",
      "action" : "allow",
      "ports" : "443",
      "process" :"\/Applications\/Safari.app\/Contents\/MacOS\/Safari",
      "protocol" : "tcp",
      "remote-domains" : [
        "plex.tv",
  	    "filen-1.net",
        "filen-2.net",
        "filen-3.net",
        "filen-4.net",
        "filen-5.net",
  	    "filen.com",
        "filen.io",
  	    "seedbox.io",
        "exto.to",
	    "extto.com"
  	     ]
    }
  ]
}
