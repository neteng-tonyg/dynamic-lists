{
  "name": "Librewolf-3.25-Nov",
    "description" :
    "AnyProc + MajorDomains+Reddit+Lucid+Plex+Filen",
  "rules": [
        {
        "notes" :  "211-Allow nat-stun-UDP-3478",
        "action" : "allow",
        "ports" : "3478",
        "process" : "\/Applications\/LibreWolf.app\/Contents\/MacOS\/librewolf",
        "protocol" : "udp",
        "remote" : "any"
        },
       {
	  "notes" : "222-Allow Cloudflare ports 80,443",
      "action": "allow",
      "ports": "80, 443",
       "process" : "\/Applications\/LibreWolf.app\/Contents\/MacOS\/librewolf",
      "protocol": "tcp",
      "remote-domains": [
        "cloudflare.com",
        "cloudflare.net",
        "cloudflare-dns.com",
        "cloudflarecaptcha.com",
        "cloudflareinsights.com",
        "cloudfront.net",
        "digicert.com",
        "sectigo.com"
        ]
    },
    {
     "notes" : "233-Google/ Youtube Domains 443",
     "action" : "allow",
     "ports" : "443",
      "process" : "\/Applications\/LibreWolf.app\/Contents\/MacOS\/librewolf",
          "protocol" : "tcp",
          "remote-domains" : [
		  "googlevideo.com",
		  "www.google.com",
          "mail.google.com",
		  "googleapps.com",
		  "googleusercontent.com",
		  "googletagmanager.com",
		  "gogleanalytics.com",
		  "google-analytics.com",
		  "googlesyndication.com",
		  "googletagservices.com",
          "www.googleadservices.com",
		  "googleapis.com",
		  "withgoogle.com",
          "i.google.com",
		  "stun1.l.google.com",
		  "accounts.google.com",
		  "www.gstatic.com",
		  "gstatic.com",
			"youtube.com",
			"youtube.be"
            ]
      },
      {
      "notes" : "237-Google/ Youtube Hosts 443",
      "action" : "allow",
      "ports" : "443",
      "process" : "\/Applications\/LibreWolf.app\/Contents\/MacOS\/librewolf",
      "protocol" : "tcp",
      "remote-hosts" :[
		  "dl.google.com",
		  "www.google.com",
          "chat.google.com",
          "news.google.com",
          "calendar.google.com",
          "workspace.google.com",
          "i.google.com",
		  "update.googleapi.com",
		  "accounts.google.com",
		  "play.google.com",
		  "fonts.gstatic.com",
		  "c.youtube.com",
          "m.youtube.com",
		  "accounts.youtube.com"
            ]
      },
      {
  	    "notes" : "333-Mozilla Domains 443",
        "action" : "allow",
        "ports": "80, 443",
   		"process" : "\/Applications\/LibreWolf.app\/Contents\/MacOS\/librewolf",
        "protocol" : "tcp",
