{
  "name": "Edge-3.22-Nov",
   "description":
  "AnyProc + MajorDomains+Reddit+Lucid+Plex+Filen",
  "rules": [
    {
      "notes" : "Random AI domains",
      "action": "allow",
      "ports": "443",
      "process" : "\/Applications\/Microsoft Edge.app\/Contents\/MacOS\/Microsoft Edge",
      "protocol": "tcp",
      "remote-domains": [
        "duck.ai",
		"urboscribe.ai",
		"factors.ai",
		"engagement.ai",
		"reco.ai",
		"hybrid.ai",
        "huggingface.co"
        ]
    },
        {
      "notes" : "Random Top Domains",
      "action": "allow",
      "ports": "443",
      "process" : "\/Applications\/Microsoft Edge.app\/Contents\/MacOS\/Microsoft Edge",
      "protocol": "tcp",
      "remote-domains": [
        "nmap.com",
		"nmap.org",
		"videolan.org",
		"mail.com",
		"reco.ai",
		"hybrid.ai"
        ]
    },
    {
        "notes": "Reddit WWW",
        "action": "allow",
        "process" : "\/Applications\/Microsoft Edge.app\/Contents\/MacOS\/Microsoft Edge",
        "protocol": "tcp",
        "remote-domains": [
        "redditspace.com",
        "redditstatic.com",
        "Redditmedia.com",
        "reddit.com",
        "www.reddit.com",
        "preview.redd.it",
        "redd.it"
        ]
    },
        {
      "notes" : "Lucid",
      "action": "allow",
      "ports": "443",
      "process" : "\/Applications\/Microsoft Edge.app\/Contents\/MacOS\/Microsoft Edge",
      "protocol": "tcp",
      "remote-domains": [
        "lucid.app",
        "excalidraw.com",
        "lucidcdn.net",
        "lucidchart.net"
        ]
    }
  ]
}
