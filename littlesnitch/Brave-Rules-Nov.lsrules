{
  "name": "Brave-Rules-Nov",
   "description" :
    "AnyProc + Major DomainsReddit+Lucid+Plex+Filen",
  "rules": [
    {
    "notes ": "Default Deny Quic",
    "priority" : "high",
    "action": "deny",
    "ports": "443",
      "process" : "\/Applications\/Brave Browser.app\/Contents\/MacOS\/Brave Browser",
    "protocol": "udp",
    "remote": "any"
    },
    {
    "notes" : "Allow nat-stun-UDP-3478",
    "action" : "allow",
    "ports" : "3478",
    "priority" : "high",
      "process" : "\/Applications\/Brave Browser.app\/Contents\/MacOS\/Brave Browser",
    "protocol" : "udp",
    "remote" : "any"
  },
  {
    "notes" : "0.Default deny WWW/443",
    "action" : "deny",
    "ports" : "443",
    "priority" : "high",
    "process" : "\/Applications\/Brave Browser.app\/Contents\/MacOS\/Brave Browser",
    "protocol" : "tcp",
    "remote-domains" : [
    "facebook.com",
    "facebook.net",
    "tiktokcdn.com",
    "g.doubleclick.net",
    "static.doubleclick.net"
    ]
  },
       {
	"notes":"011.Cloudflare ports 80,443",
      "action": "allow",
      "ports": "80, 443",
      "priority" : "high",
       "process" : "\/Applications\/Brave Browser.app\/Contents\/MacOS\/Brave Browser",
      "protocol": "tcp",
      "remote-domains": [
        "cloudflare.com",
        "cloudflare-dns.com",
        "digicert.com",
        "sectigo.com",
        "cloudflare.net",
        "sectigo.net"
        ]
    },
    {
      "notes":"111 Deny Google Analytics Subnets",
      "action" : "deny",
      "ports" : "any",
       "process" : "\/Applications\/Brave Browser.app\/Contents\/MacOS\/Brave Browser",
      "protocol" : "tcp",
      "remote-addresses" : [
	  "64.233.177.0/24",
	  "173.194.219.0/24",
	  "142.250.105.0/24",
	  "142.250.9.0/24",
	  "74.125.21.0/24"
	  ]
    },
        {
      "notes" : "111 Deny Google Analytics Hosts",
      "action" : "deny",
      "ports" : "443",
      "priority" : "high",
       "process" : "\/Applications\/Brave Browser.app\/Contents\/MacOS\/Brave Browser",
      "protocol" : "tcp",
      "remote-hosts" : [
	  "i.doubleclick.net",
	  "g.doubleclick.net",
        "ad.doubleclick.net",
		"fls.doubleclick.net",
	  "pubads.g.doubleclick.net",
	  "pagead2.googlesyndication.com",
	  "googleads4.g.doubleclick.net",
	  "ep1.adtrafficquality.google",
      "adservice.google.com",
      "adtrafficquality.google.com"
	  ]
    },
    {
     "notes" : "Google/ Youtube Domains 443",
     "action" : "allow",
