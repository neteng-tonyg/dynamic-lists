{
  "name": "Firefox-Rules-Nov",
  "description": "Standard app traffic from Firefox",
  "rules": [
  {
    "notes":"0.Default deny quic",
    "action" : "deny",
    "ports" : "443",
    "priority" : "high",
    "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
    "protocol" : "udp",
    "remote" : "any"
  },
  {
    "notes":"0.Allow nat-stunUDP",
    "action" : "allow",
    "ports" : "3478",
    "priority" : "high",
    "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
    "protocol" : "udp",
    "remote" : "any"
  },
  {
    "notes":"0.Default deny WWW/443",
    "action" : "deny",
    "ports" : "443",
    "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
    "protocol" : "tcp",
    "remote-domains" :
    [
    "facebook.com",
    "facebook.net",
    "tiktokcdn.com",
    "g.doubleclick.net",
    "static.doubleclick.net"
    ]
  },
    {
      "description" : "Plex",
      "name" : "Plex-subs-et-al",
      "action" : "allow",
      "ports" : "443",
          "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
      "protocol" : "tcp",
      "remote-hostnames" : [
	  "clients.plex.tv",
      "features.plex.tv",
	  "community.plex.tv",
	  "provider.plex.tv",
	  "pubsub.plex.tv",
	  "together.plex.tv"
	    ]
    },
    {
      "notes": "Major Domains 443",
      "action": "allow",
      "ports": "443",
      "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
      "protocol": "tcp",
      "remote-domains": [
        "cisco.com",
        "meraki.com",
        "meraki.net",
        "scroller.com",
        "wikipedia.com",
        "wikihow.com",
        "wikimedia.net",
        "wikimedia.org",
        "whatismyipaddress.com",
        "iplookup.com",
        "noip.com",
		"check-host.net",
        "brave.com",
        "bravesoftware.com",
        "bing.com",
        "duckduckgo.com",
        "duck.ai",
        "dogpile.com",
        "lifewire.com",
        "supermedia.com",
        "obdev.net",
        "dropbox.com",
        "costco.com",
        "ublockorigin.pages.dev"
      ]
    },
      {
        "notes":"Google/ Youtube Domains 443",
      "action" : "allow",
      "ports" : "443",
      "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
      "owner" : "me",
      "protocol" : "tcp",
      "remote-domains" : [
		  "googlevideo.com",
		  "www.google.com",
		  "googleapps.com",
		  "googleusercontent.com",
		  "googletagmanager.com",
		  "gogleanalytics.com",
		  "google-analytics.com",
		  "googlesyndication.com",
		  "googletagservices.com",
		  "googleapis.com",
		  "withgoogle.com",
		  "www.gstatic.com",
		  "gstatic.com",
			"youtube.com",
			"youtube.be"
            ]
      },
            {
        "notes":"Google/ Youtube Hosts 443",
      "action" : "allow",
      "ports" : "443",
      "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
      "owner" : "me",
      "protocol" : "tcp",
      "remote-hostnames" : [
		  "dl.google.com",
		  "www.google.com",
          "i.google.com",
		  "stun1.l.google.com",
		  "accounts.google.com",
		  "play.google.com",
		  "fonts.gstatic.com",
			"c.youtube.com",
			"accounts.youtube.com"
            ]
      },
      {
  	    "notes":"Mozilla Domains 443",
        "action" : "allow",
        "ports" : "443",
   		 "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
        "protocol" : "tcp",
        "remote-domains" : [
        "mozilla.com",
  		"mozilla.net",
  		"mozgcp.net",
  		  "firefox.com",
          "firefox.org"
          ]
      },
      {
  	    "notes":"Mozilla Hostnames 443",
        "action" : "allow",
        "ports" : "443",
   		    "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
   		"owner" :"me",
        "protocol" : "tcp",
        "remote-hostnames" : [
        "classify-services.mozilla.com",
        "services.mozilla.com",
        "firefox.settings.services.mozilla.com",
  		"mozilla-ohttp.fastly-edge.com",
  		"ohttp-merino.mozilla.fastly-edge.com",
  		"mozilla.fastly-edge.com",
  		"addons.mozilla.org",
        "aus5.mozilla.org",
        "download.mozilla.org",
        "telemetry.mozilla.org",
        "vpn.mozilla.org",
        "classify-services.mozilla.com",
        "services.mozilla.com",
        "firefox.settings.services.mozilla.com",
  		"mozilla-ohttp.fastly-edge.com",
  		"ohttp-merino.mozilla.fastly-edge.com",
  		"mozilla.fastly-edge.com",
		"ads-img.mozilla.org",
		  "accounts.firefox.com",
          "firefox-portal-detection.com",
          "ads.mozilla.org"
          ]
      },
      {
      "action": "allow",
      "notes": "Cloudflare/ 80",
      "ports": "80",
      "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
      "protocol": "tcp",
      "remote-domains": [
        "cloudflare.com",
        "cloudflarecaptcha.com",
        "cloudflare-dns.com",
        "cloudflareinsights.com",
        "digicert.com",
        "sectigo.com",
        "cloudflare.net",
        "sectigo.net"
          ]
      },
      {
      "notes" : "Cloudflare/ 443",
      "action": "allow",
      "ports": "443",
      "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
      "protocol": "tcp",
      "remote-domains": [
        "cloudflare.com",
        "cloudflare-dns.com",
        "digicert.com",
        "sectigo.com",
        "cloudflare.net",
        "sectigo.net"
          ]
      },
      {
        "notes":"Git Domains 443",
        "owner" : "me",
        "action" : "allow",
        "ports" : "443",
        "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
        "protocol" : "tcp",
        "remote-domains" : [
    	    "githubassets.com",
              "gitlab.com",
              "gitlab.dev",
              "gitlab.io",
           "githubusercontent.com",
           "github.com",
           "github.dev",
           "github.io",
           "homebrew.sh"
            ]
       },
         {
            "notes":"Git Hosts 443",
            "owner" : "me",
            "action" : "allow",
            "ports" : "443",
            "process" : "any",
            "protocol" : "tcp",
            "remote-hostnames" : [
            "raw.githubusercontent.com",
  	        "malware-filter.gitlab.io",
            "avatars.githubusercontent.com",
            "cafe.github.com",
            "central.github.com"
               ]
          },
        {
        "description": "Microsoft-related domains",
        "name": "Microsoft",
        "action": "allow",
        "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
        "owner": "me",
        "remote-domains": [
          "azurewebsites.net",
          "bing.com",
          "hockeyapp.net",
          "live.com",
          "live.net",
          "microsoft.com",
          "microsoftonline.com",
          "msedge.net",
          "oaspapps.com",
          "office.com",
          "office.net",
          "office365.com",
          "onedrive.com",
          "outlook.com",
          "skype.com",
          "windows.com",
          "blob.core.windows.net"
            ]
        },
        {
        "description": "Reddit WWW",
        "name": "Reddit",
        "action": "allow",
        "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
        "owner": "me",
        "remote-domains": [
        "redditspace.com",
        "redditstatic.com",
        "Redditmedia.com",
        "Reddit.com",
        "preview.redd.it"
          ]
      },
      {
      "description": "Bitdefender WWW",
      "action": "allow",
      "ports": "443",
      "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
      "protocol": "tcp",
      "remote-hostnames": [
        "download.bitdefender.com",
        "securepass-auth.bitdefender.com",
        "cdn.bitdefender.net",
        "nimbus.bitdefender.net",
        "us.nimbus.bitdefender.net",
        "push.bitdefender.net"
      ]
    },
    {
	"notes":"Cloudflare port 80",
      "action": "allow",
      "ports": "80",
    "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
      "protocol": "tcp",
      "remote-domains": [
        "cloudflare.com",
        "cloudflare-dns.com",
        "static.cloudflareinsights.com",
        "digicert.com",
        "sectigo.com",
        "cloudflare.net",
        "cloudfront.net",
        "sectigo.net"
      ]
    },
    {
      "action": "allow",
      "ports": "443",
  "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
      "protocol": "tcp",
      "remote-domains": [
        "cloudflare.com",
        "cloudflare-dns.com",
        "digicert.com",
        "sectigo.com",
        "cloudflare.net",
        "sectigo.net"
      ]
    },
    {
      "action": "allow",
      "ports": "443",
  "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
      "protocol": "tcp",
      "remote-domains": [
        "bluehost.com",
	"nixihost.com",
	"audaxum.me",
	"goethals.us"
      ]
    },
        {
     "notes":"Filen and Seedbox ",
      "action" : "allow",
      "ports" : "443",
      "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
      "protocol" : "tcp",
      "remote-domains" : [
  	"filen-1.net", "filen-2.net", "filen-3.net","filen-4.net","filen-5.net",
  	"filen.com",
  	"seedbox.io",
	"extto.com"
  	]
    },
    {
      "action": "allow",
      "ports": "443",
  "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
      "protocol": "tcp",
      "remote-domains": [
        "lucid.app",
        "excalidraw.com",
        "lucidcdn.net",
        "lucidchart.net"
      ]
    }
  ]
}
