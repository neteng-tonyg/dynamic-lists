{
  "name": "Any-Process-Rules 16",
  "description":
     "Standard  traffic: Cloudflare/ Google Block/ Mozilla 443/80, GitHub, Microsoft, Bitdefender, Personal ",

  "rules": [
    {
    "notes ": "Default Deny Quic",
    "action": "deny",
    "ports": "443",
    "process": "any",
    "protocol": "udp",
    "remote": "any"
    },
    {
    "notes": "Allow nat-stun-UDP-3478",
  "action" : "allow",
    "ports" : "3478",
    "priority" : "high",
     "process" : "any",
    "protocol" : "udp",
    "remote" : "any"
  },
  {
    "notes":"0.Default deny WWW/443",
    "action" : "deny",
    "ports" : "443",
    "process" : "any",
    "protocol" : "tcp",
    "remote-domains" : [
    "facebook.com",
    "facebook.net",
    "tiktokcdn.com",
    "g.doubleclick.net",
    "static.doubleclick.net"
    ]
  },
       {
	"notes":"011.Cloudflare ports 80,443",
      "action": "allow",
      "ports": "80, 443",
       "process" : "anyr",
      "protocol": "tcp",
      "remote-domains": [
        "cloudflare.com",
        "cloudflare-dns.com",
        "digicert.com",
        "sectigo.com",
        "cloudflare.net",
        "sectigo.net"
        ]
    },
    {
     "notes":"Google/ Youtube Domains 443",
     "action" : "allow",
     "ports" : "443",
    "process" : "any",
          "protocol" : "tcp",
          "remote-domains" : [
		  "googlevideo.com",
		  "google.com",
		  "dl.google.com",
		  "accounts.google.com",
		  "googleapps.com",
		  "googleusercontent.com",
		  "googletagmanager.com",
		  "gogleanalytics.com",
		  "google-analytics.com",
		  "googlesyndication.com",
		  "googletagservices.com",
		  "googleapis.com",
		  "withgoogle.com",
		  "fonts.gstatic.com",
		  "www.gstatic.com",
		  "gstatic.com",
			"youtube.com",
			"youtube.be"
            ]
      },
      {
        "notes":"Google/ Youtube Hosts 443",
      "action" : "allow",
      "ports" : "443",
      "process" : "any",
      "owner" : "me",
      "protocol" : "tcp",
      "remote-hosts" :
        [
		  "dl.google.com",
		  "www.google.com",
          "i.google.com",
		  "stun1.l.google.com",
		  "accounts.google.com",
		  "play.google.com",
		  "fonts.gstatic.com",
			"c.youtube.com",
			"accounts.youtube.com"
            ]
      },
      {
  	    "notes":"Mozilla Domains 443",
        "action" : "allow",
        "ports" : "443",
   		"process" : "any",
        "protocol" : "tcp",
        "remote-domains" : [
        "mozilla.com",
  		"mozilla.net",
  		"mozgcp.net",
  		  "firefox.com",
          "firefox.org"
          ]
      },
      {
  	    "notes":"Mozilla Domains 443",
        "action" : "allow",
        "ports" : "443",
   		"process" : "any",
        "protocol" : "tcp",
        "remote-domains" : [
        "mozilla.com",
  		"mozilla.net",
  		"mozgcp.net",
  		  "firefox.com",
          "firefox.org",
          "firefox-portal-detection.com"
        ]
      },
      {
  	    "notes":"Mozilla hosts 443",
        "action" : "allow",
        "ports" : "443, 80",
   		"process" : "any",
        "protocol" : "tcp",
        "remote-hosts" : [
        "classify-services.mozilla.com",
        "services.mozilla.com",
        "firefox.settings.services.mozilla.com",
  		"mozilla-ohttp.fastly-edge.com",
  		"ohttp-merino.mozilla.fastly-edge.com",
  		"mozilla.fastly-edge.com",
  		"addons.mozilla.org",
        "aus5.mozilla.org",
        "download.mozilla.org",
        "telemetry.mozilla.org",
        "vpn.mozilla.org",
        "classify-services.mozilla.com",
        "services.mozilla.com",
        "firefox.settings.services.mozilla.com",
  		"mozilla-ohttp.fastly-edge.com",
  		"ohttp-merino.mozilla.fastly-edge.com",
  		"mozilla.fastly-edge.com",
		"ads-img.mozilla.org",
		  "accounts.firefox.com",
          "ads.mozilla.org"
          ]
      },
      {
        "notes":"Git Domains 443",
        "owner" : "me",
        "action" : "allow",
        "ports" : "443",
        "process": "any",
        "protocol" : "tcp",
        "remote-domains" : [
    	    "githubassets.com",
              "gitlab.com",
              "gitlab.dev",
              "gitlab.io",
           "githubusercontent.com",
           "github.com",
           "github.dev",
           "github.io",
           "homebrew.sh"
            ]
       },
         {
            "notes":"Git Hosts 443",
            "owner" : "me",
            "action" : "allow",
            "ports" : "443",
            "process" : "any",
            "protocol" : "tcp",
            "remote-hosts" : [
            "raw.githubusercontent.com",
  	        "malware-filter.gitlab.io",
            "avatars.githubusercontent.com",
            "cafe.github.com",
            "central.github.com"
               ]
          },
        {
        "description": "Microsoft-related domains",
        "name": "Microsoft",
        "action": "allow",
          "ports" : "443",
        "process": "any",
        "owner": "me",
        "remote-domains": [
          "azurewebsites.net",
          "azurefed.net",
          "azurefed.com",
          "bing.com",
          "hockeyapp.net",
          "live.com",
          "live.net",
          "microsoft.com",
          "microsoftonline.com",
          "msedge.net",
          "oaspapps.com",
          "office.com",
          "office.net",
          "office365.com",
          "onedrive.com",
          "outlook.com",
          "skype.com",
          "windows.com",
          "blob.core.windows.net"
            ]
        },
      {
      "description": "Bitdefender WWW",
      "action": "allow",
      "ports": "443",
      "process" : "any",
      "protocol": "tcp",
      "remote-hosts": [
        "download.bitdefender.com",
        "securepass-auth.bitdefender.com",
        "cdn.bitdefender.net",
        "nimbus.bitdefender.net",
        "us.nimbus.bitdefender.net",
        "push.bitdefender.net"
      ]
    },
    {
      "action": "allow",
      "ports": "443",
      "process" : "any",
      "protocol": "tcp",
      "remote-domains": [
        "bluehost.com",
	    "nixihost.com",
	    "audaxum.me",
	    "goethals.us"
      ]
    }
  ]
}











































