{
 "name": "Zen-Rules",
  "description": "Standard app traffic Zen",
  "rules" : [
    {
      "notes":"111 Deny Google Analytics Domains",
      "action" : "deny",
      "ports" : "443",
      "process" : "\/Applications\/Zen.app\/Contents\/MacOS\/zen",
      "protocol" : "tcp",
      "remote-domains" : [
	  "googleadservices.com",
	  "googlesyndication.com",
      "www.googleadservices.com",
	  "doubleclick.net"
	  ]
    },
    {
      "notes":"111 Deny Google Analytics Hosts",
      "action" : "deny",
      "ports" : "443",
      "process" : "\/Applications\/Zen.app\/Contents\/MacOS\/zen",
      "protocol" : "tcp",
      "remote-hostnames" : [
	  "i.doubleclick.net",
	  "g.doubleclick.net",
        "ad.doubleclick.net",
		"fls.doubleclick.net",
	  "pubads.g.doubleclick.net",
	  "pagead2.googlesyndication.com",
	  "googleads4.g.doubleclick.net",
	  "ep1.adtrafficquality.google",
      "adservice.google.com",
      "adtrafficquality.google.com"
	  ]
    },
          {
            "notes":"Google/ Youtube Domains 443",
      "action" : "allow",
      "ports" : "443",
      "process" : "\/Applications\/Brave Browser.app\/Contents\/MacOS\/Brave Browser",
      "owner" : "me",
      "protocol" : "tcp",
      "remote-domains" : [
		  "googlevideo.com",
		  "www.google.com",
		  "googleapps.com",
		  "googleusercontent.com",
		  "googletagmanager.com",
		  "gogleanalytics.com",
		  "google-analytics.com",
		  "googlesyndication.com",
		  "googletagservices.com",
		  "googleapis.com",
		  "withgoogle.com",
		  "www.gstatic.com",
		  "gstatic.com",
			"youtube.com",
			"youtube.be"
            ]
      },
            {
        "description": "Microsoft-related domains",
        "name": "Microsoft",
        "action": "allow",
        "process" : "\/Applications\/Zen.app\/Contents\/MacOS\/zen",
        "owner": "me",
        "remote-domains": [
          "azurewebsites.net",
          "azurefed.net",
          "azurefed.com",
          "bing.com",
          "hockeyapp.net",
          "live.com",
          "live.net",
          "microsoft.com",
          "microsoftonline.com",
          "msedge.net",
          "oaspapps.com",
          "office.com",
          "office.net",
          "office365.com",
          "onedrive.com",
          "outlook.com",
          "skype.com",
          "windows.com",
          "blob.core.windows.net"
            ]
        },
        {
        "description": "Reddit WWW",
        "name": "Reddit",
        "action": "allow",
        "process" : "\/Applications\/Zen.app\/Contents\/MacOS\/zen",
        "owner": "me",
        "remote-domains": [
        "redditspace.com",
        "redditstatic.com",
        "Redditmedia.com",
        "Reddit.com",
        "preview.redd.it"
          ]
      },
    {
      "action" : "allow",
      "ports" : "443",
      "process" : "\/Applications\/Zen.app\/Contents\/MacOS\/zen",
      "protocol" : "tcp",
      "remote-domains" : [
	"googleapis.com",
	"pubmatic.com",
	"forbes.com",
	  "azurefed.net",
	  "azurefed.com"
	  ]
    },
    {
    "notes":"111 Deny Google Analytics Subnets",
      "action" : "deny",
      "ports" : "443",
      "process" : "\/Applications\/Zen.app\/Contents\/MacOS\/zen",
      "protocol" : "tcp",
      "remote-addresses" : [
	  "64.233.177.0/24",
	  "173.194.219.0/24",
	  "142.250.105.0/24",
	  "142.250.9.0/24",
	  "74.125.21.0/24"
	  ]
    }
  ]
}
