{
 "name": "Zen-3.22",
  "description":
  "Custom rules-Zen : QUIC+Google+MS+Mozilla+Cloudflare",
    "rules": [
    {
    "notes ": "000-Default Deny Quic",
    "priority" : "high",
    "action": "deny",
    "ports": "443",
    "process" : "\/Applications\/Zen.app\/Contents\/MacOS\/zen",
    "protocol": "udp",
    "remote": "any"
    },
    {
    "notes": "Allow nat-stun-UDP-3478",
  "action" : "allow",
    "ports" : "3478",
    "priority" : "high",
     "process" : "\/Applications\/Zen.app\/Contents\/MacOS\/zen",
    "protocol" : "udp",
    "remote" : "any"
  },
  {
    "notes":"0.Default deny WWW/443",
    "action" : "deny",
    "ports" : "443",
    "process" : "\/Applications\/Zen.app\/Contents\/MacOS\/zen",
    "protocol" : "tcp",
    "remote-domains" : [
      "facebook.com",
      "facebook.net",
      "tiktokcdn.com",
      "g.doubleclick.net",
      "static.doubleclick.net"
      ]
  },
    {
      "notes":"111-Deny Google Analytics Subnets",
      "priority" : "high",
      "action" : "deny",
      "ports" : "any",
      "process" : "\/Applications\/Zen.app\/Contents\/MacOS\/zen",
      "protocol" : "tcp",
      "remote-addresses" : [
	    "64.233.177.0/24",
	    "173.194.219.0/24",
	    "142.250.105.0/24",
	    "142.250.9.0/24",
	    "74.125.21.0/24"
	  ]
    },
        {
      "notes" : "117-Deny Google Analytics Hosts",
      "action" : "deny",
      "ports" : "443",
      "priority" : "high",
      "process" : "\/Applications\/Zen.app\/Contents\/MacOS\/zen"    ,
      "protocol" : "tcp",
      "remote-hosts" : [
	    "i.doubleclick.net",
	    "g.doubleclick.net",
        "ad.doubleclick.net",
		"fls.doubleclick.net",
	    "pubads.g.doubleclick.net",
	    "pagead2.googlesyndication.com",
	    "googleads4.g.doubleclick.net",
	    "ep1.adtrafficquality.google",
        "adservice.google.com",
        "adtrafficquality.google.com"
	  ]
    },
        {
      "notes" :  "211-Allow nat-stun-UDP-3478",
        "action" : "allow",
        "ports" : "3478",
        "process" : "\/Applications\/Zen.app\/Contents\/MacOS\/zen",
        "protocol" : "udp",
        "remote" : "any"
        },
       {
	  "notes" : "222-Allow Cloudflare ports 80,443",
      "action": "allow",
      "ports": "80, 443",
      "process" : "\/Applications\/Zen.app\/Contents\/MacOS\/zen",
      "protocol": "tcp",
      "remote-domains": [
        "cloudflare.com",
        "cloudflare.net",,
        "cloudflare-dns.com",
        "cloudflarecaptcha.com",
        "cloudflareinsights.com",
        "cloudfront.net",
        "digicert.com",
        "sectigo.com"
        ]
    },
    {
     "notes":"Google/ Youtube Domains 443",
     "action" : "allow",
     "ports" : "443",
     "process" : "\/Applications\/Zen.app\/Contents\/MacOS\/zen", 
      "protocol" : "tcp",
      "remote-domains" : [
		  "googlevideo.com",
		  "www.google.com",
		  "googleapps.com",
		  "googleusercontent.com",
		  "googletagmanager.com",
		  "gogleanalytics.com",
		  "google-analytics.com",
		  "googlesyndication.com",
		  "googletagservices.com",
		  "googleapis.com",
		  "withgoogle.com",
          "i.google.com",
		  "stun1.l.google.com",
		  "accounts.google.com",
		  "www.gstatic.com",
		  "gstatic.com",
			"youtube.com",
			"youtube.be"
            ]
      },
      {
        "notes":"Google/ Youtube Hosts 443",
      "action" : "allow",
      "ports" : "443",
      "process" : "\/Applications\/Zen.app\/Contents\/MacOS\/zen",
      "protocol" : "tcp",
      "remote-hosts" :[
		  "dl.google.com",
		  "www.google.com",
          "i.google.com",
		  "stun1.l.google.com",
		  "accounts.google.com",
		  "play.google.com",
		  "fonts.gstatic.com",
		  "c.youtube.com",
		  "accounts.youtube.com"
            ]
      },
      {
  	    "notes" : "333-Mozilla Domains 443",
        "action" : "allow",
        "ports": "80, 443",
   		"process" : "\/Applications\/Zen.app\/Contents\/MacOS\/zen",
        "protocol" : "tcp",
        "remote-domains" : [
          "mozilla.com",
  		  "mozilla.net",
          "mozilla.org",
  		  "mozgcp.net",
  		  "firefox.com",
          "firefox.org",
          "firebase.io",
          "firefox-portal-detection.com"
          ]
      },
      {
  	    "notes" : "335-Mozilla Hosts 443",
        "action" : "allow",
        "ports": "80, 443",
   		"process" : "\/Applications\/Zen.app\/Contents\/MacOS\/zen",
        "protocol" : "tcp",
        "remote-hosts" : [
        "classify-services.mozilla.com",
        "accounts.firefox.com",
        "services.mozilla.com",
        "incoming.telemetry.mozilla.org",
        "aus5.mozilla.org",
        "addons.mozilla.org",
        "ads-img.mozilla.org",
        "ads.mozilla.org",
        "download.mozilla.org",
        "vpn.mozilla.org",
        "ohttp-merino.mozilla.fastly-edge.com",
        "mozilla-ohttp.fastly-edge.com",
  		"mozilla.fastly-edge.com"
          ]
      },
      {
        "notes" : "Git Domains 443",
        "action" : "allow",
        "ports" : "443",
        "process" : "\/Applications\/Zen.app\/Contents\/MacOS\/zen",
        "protocol" : "tcp",
        "remote-domains" : [
            "githubassets.com",
            "gitlab.com",
            "gitlab.dev",
            "gitlab.io",
           "githubusercontent.com",
           "github.com",
           "github.dev",
           "github.io",
           "homebrew.sh"
            ]
       },
         {
            "notes" : "Git Hosts 443",
            "action" : "allow",
            "ports" : "443",
            "process" : "\/Applications\/Zen.app\/Contents\/MacOS\/zen",
            "protocol" : "tcp",
            "remote-hosts" : [
 	        "individual.githubcopilot.com",
            "avatars.githubusercontent.com",
            "raw.githubusercontent.com",
  	        "malware-filter.gitlab.io",
            "cafe.github.com",
            "central.github.com"
               ]
          },
        {
        "notes" : "Microsoft/ Office domains",
        "action": "allow",
          "ports" : "443",
        "process" : "\/Applications\/Zen.app\/Contents\/MacOS\/zen",
        "remote-domains": [
          "azurewebsites.net",
          "azurefed.net",
          "azurefed.com",
          "bing.com",
          "hockeyapp.net",
          "live.com",
          "live.net",
          "microsoft.com",
          "microsoftonline.com",
          "msedge.net",
          "oaspapps.com",
          "office.com",
          "office.net",
          "office365.com",
          "onedrive.com",
          "outlook.com",
          "skype.com",
          "windows.com",
          "blob.core.windows.net"
            ]
        }
  ]
}