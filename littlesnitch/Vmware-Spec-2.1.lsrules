{
  "name": "VMware-3.22-Nov",
  "description":
      "Standard app traffic  WMware",
  "rules" : [
      {
    "notes ": "000-Default Deny Quic",
    "priority" : "high",
    "action": "deny",
    "ports": "443",
     "process" : "\/Applications\/VMware Fusion.app\/Contents\/MacOS\/VMware Fusion",
    "protocol": "udp",
    "remote": "any"
    },
    {
    "notes" : "003-Default deny WWW/443",
    "priority" : "high",
    "action" : "deny",
    "ports" : "443",
    "process" : "\/Applications\/VMware Fusion.app\/Contents\/MacOS\/VMware Fusion",
    "protocol" : "tcp",
    "remote-domains" : [
    "facebook.com",
    "facebook.net",
    "tiktokcdn.com",
    "g.doubleclick.net",
    "static.doubleclick.net"
    ]
  },
    {
      "notes":"111-Deny Google Analytics Subnets",
      "priority" : "high",
      "action" : "deny",
      "ports" : "any",
      "process" : "\/Applications\/VMware Fusion.app\/Contents\/MacOS\/VMware Fusion",
      "protocol" : "tcp",
      "remote-addresses" : [
	  "64.233.177.0/24",
	  "173.194.219.0/24",
	  "142.250.105.0/24",
	  "142.250.9.0/24",
	  "74.125.21.0/24"
	  ]
    },
        {
      "notes" : "117-Deny Google Analytics Hosts",
      "action" : "deny",
      "ports" : "443",
      "priority" : "high",
        "process" : "\/Applications\/VMware Fusion.app\/Contents\/MacOS\/VMware Fusion",
      "protocol" : "tcp",
      "remote-hosts" : [
	  "i.doubleclick.net",
	  "g.doubleclick.net",
        "ad.doubleclick.net",
		"fls.doubleclick.net",
	  "pubads.g.doubleclick.net",
	  "pagead2.googlesyndication.com",
	  "googleads4.g.doubleclick.net",
	  "ep1.adtrafficquality.google",
      "adservice.google.com",
      "adtrafficquality.google.com"
	  ]
    },
        {
        "notes" :  "211-Allow nat-stun-UDP-3478",
        "action" : "allow",
        "ports" : "3478",
        "priority" : "high",
        "process" : "\/Applications\/VMware Fusion.app\/Contents\/MacOS\/VMware Fusion",
        "protocol" : "udp",
        "remote" : "any"
    },
       {
	"notes" : "222-Allow Cloudflare ports 80,443",
      "action": "allow",
      "ports": "80, 443",
      "priority" : "high",
      "process" : "\/Applications\/VMware Fusion.app\/Contents\/MacOS\/VMware Fusion",
      "protocol": "tcp",
